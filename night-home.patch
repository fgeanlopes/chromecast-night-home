diff --git a/launcher/app/src/test/java/com/gathin/tvhome/HomeLookTest.java b/launcher/app/src/test/java/com/gathin/tvhome/HomeLookTest.java
new file mode 100644
index 0000000..b11c93a
--- /dev/null
+++ b/launcher/app/src/test/java/com/gathin/tvhome/HomeLookTest.java
@@ -0,0 +1,156 @@
+package com.gathin.tvhome;
+
+import org.junit.Test;
+
+import java.util.HashMap;
+import java.util.Map;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+public class HomeLookTest {
+    private static HomeLook look(Object... keyValues) {
+        Map<String, Object> saved = new HashMap<>();
+        for (int i = 0; i < keyValues.length; i += 2) saved.put((String) keyValues[i], keyValues[i + 1]);
+        return HomeLook.from(saved);
+    }
+
+    // deve usar os padrões da especificação numa instalação nova
+    @Test public void aFreshInstallUsesTheSpecDefaults() {
+        HomeLook l = look();
+        assertEquals(HomeLook.Cards.CLASSIC, l.cards);
+        assertEquals(HomeLook.Background.SKY, l.background);
+        assertTrue(l.greeting);
+        assertFalse(l.bigClock);
+        assertTrue(l.smallClock);
+        assertTrue(l.date);
+        assertFalse(l.biggerCards);
+        assertFalse(l.headerTemperature);
+        assertTrue(l.weatherLine);
+    }
+
+    // deve ler os interruptores de temperatura sem alterar os outros
+    @Test public void temperatureSwitchesAreIndependent() {
+        HomeLook l = look(HomeLook.KEY_HEADER_TEMPERATURE, true, HomeLook.KEY_WEATHER_LINE, false);
+        assertTrue(l.headerTemperature);
+        assertFalse(l.weatherLine);
+        assertTrue(l.greeting);
+        HomeLook after = l.with(HomeLook.KEY_WEATHER_LINE, true);
+        assertTrue(after.weatherLine);
+        assertTrue(after.headerTemperature);
+    }
+
+    // deve ler cada escolha salva de forma independente
+    @Test public void readsEverySavedChoiceIndependently() {
+        HomeLook l = look(HomeLook.KEY_CARDS, "night", HomeLook.KEY_BACKGROUND, "midnight",
+                HomeLook.KEY_GREETING, false, HomeLook.KEY_BIG_CLOCK, true, HomeLook.KEY_SMALL_CLOCK, false,
+                HomeLook.KEY_DATE, false, HomeLook.KEY_BIGGER_CARDS, true);
+        assertEquals(HomeLook.Cards.NIGHT, l.cards);
+        assertEquals(HomeLook.Background.MIDNIGHT, l.background);
+        assertFalse(l.greeting);
+        assertTrue(l.bigClock);
+        assertFalse(l.smallClock);
+        assertFalse(l.date);
+        assertTrue(l.biggerCards);
+    }
+
+    // deve voltar ao padrão quando o valor salvo é desconhecido ou de outro tipo
+    @Test public void anUnknownOrBadlyTypedValueFallsBackToTheDefault() {
+        HomeLook l = look(HomeLook.KEY_CARDS, "neon", HomeLook.KEY_BACKGROUND, 3, HomeLook.KEY_GREETING, "yes");
+        assertEquals(HomeLook.Cards.CLASSIC, l.cards);
+        assertEquals(HomeLook.Background.SKY, l.background);
+        assertTrue(l.greeting);
+    }
+
+    // deve gravar e reler as escolhas sem perder nada
+    @Test public void savedValuesRoundTrip() {
+        HomeLook l = look(HomeLook.KEY_CARDS, "glass", HomeLook.KEY_BACKGROUND, "graphite", HomeLook.KEY_DATE, false);
+        assertEquals(l.cards, HomeLook.from(l.toMap()).cards);
+        assertEquals(l.background, HomeLook.from(l.toMap()).background);
+        assertEquals(l.date, HomeLook.from(l.toMap()).date);
+    }
+
+    // deve trocar um único item sem alterar os outros
+    @Test public void changingOneChoiceLeavesTheOthersAlone() {
+        HomeLook before = look(HomeLook.KEY_CARDS, "night", HomeLook.KEY_BIG_CLOCK, true);
+        HomeLook after = before.with(HomeLook.KEY_GREETING, false);
+        assertFalse(after.greeting);
+        assertEquals(HomeLook.Cards.NIGHT, after.cards);
+        assertTrue(after.bigClock);
+        assertTrue(after.smallClock);
+    }
+
+    // deve esconder o título grande do app fora do estilo Classic
+    @Test public void onlyClassicShowsTheBigAppTitle() {
+        assertTrue(look().showsHeroTitle(true));
+        assertFalse(look().showsHeroTitle(false));
+        assertFalse(look(HomeLook.KEY_CARDS, "night").showsHeroTitle(true));
+        assertFalse(look(HomeLook.KEY_CARDS, "glass").showsHeroTitle(true));
+    }
+
+    // deve desligar o brilho de fundo no Noite e no fundo Grafite
+    @Test public void nightAndGraphiteHaveNoAmbientGlow() {
+        assertTrue(look().ambientGlow(true));
+        assertFalse(look().ambientGlow(false));
+        assertFalse(look(HomeLook.KEY_CARDS, "night").ambientGlow(true));
+        assertFalse(look(HomeLook.KEY_BACKGROUND, "graphite").ambientGlow(true));
+        assertTrue(look(HomeLook.KEY_BACKGROUND, "midnight").ambientGlow(true));
+    }
+
+    // deve usar brilho mais fraco no fundo Meia-noite
+    @Test public void midnightGlowIsSofterThanSky() {
+        assertTrue(HomeLook.Background.MIDNIGHT.glowStrength < HomeLook.Background.SKY.glowStrength);
+        assertEquals(1f, HomeLook.Background.SKY.glowStrength, 0.001f);
+    }
+
+    // deve usar contorno cinza no Noite e no Vidro e manter o do launcher no Classic
+    @Test public void nightAndGlassUseTheGreyRing() {
+        assertEquals(0, look().focusRingColor());
+        assertEquals(0xFFA8A8B0, look(HomeLook.KEY_CARDS, "night").focusRingColor());
+        assertEquals(0xFFA8A8B0, look(HomeLook.KEY_CARDS, "glass").focusRingColor());
+    }
+
+    // deve calcular o contraste no padrão WCAG
+    @Test public void contrastFollowsWcag() {
+        assertEquals(21.0, HomeLook.contrast(0xFFFFFFFF, 0xFF000000), 0.01);
+        assertEquals(1.0, HomeLook.contrast(0xFF777777, 0xFF777777), 0.01);
+    }
+
+    // deve gerar tons escuros em que o nome do app fica legível
+    @Test public void nightToneKeepsTheNameReadable() {
+        int[] vivid = {0xFFE53935, 0xFF4A6CF7, 0xFFF07A25, 0xFF7C4DFF, 0xFFFFFFFF, 0xFF000000, 0xFF20C997, 0xFFFFEB3B};
+        for (int c : vivid) {
+            int tone = HomeLook.nightTone(c);
+            assertTrue(Integer.toHexString(c), HomeLook.contrast(tone, HomeLook.NIGHT_NAME) >= 4.5);
+            assertTrue(Integer.toHexString(c), HomeLook.luminance(tone) < 0.08);
+        }
+    }
+
+    // deve manter a cor dominante do app no tom escuro
+    @Test public void nightToneKeepsTheHue() {
+        int red = HomeLook.nightTone(0xFFE53935);
+        assertTrue(((red >> 16) & 0xFF) > (red & 0xFF));
+        int blue = HomeLook.nightTone(0xFF4A6CF7);
+        assertTrue((blue & 0xFF) > ((blue >> 16) & 0xFF));
+    }
+
+    // deve montar a linha pequena só com os itens ligados e "·" entre eles
+    @Test public void smallLineJoinsOnlyTheVisibleParts() {
+        assertEquals("h:mm a '·' EEEE d MMMM", HomeLook.smallLinePattern("h:mm a", "EEEE d MMMM", true, true));
+        assertEquals("h:mm a", HomeLook.smallLinePattern("h:mm a", "EEEE d MMMM", true, false));
+        assertEquals("EEEE d MMMM", HomeLook.smallLinePattern("h:mm a", "EEEE d MMMM", false, true));
+        assertEquals("", HomeLook.smallLinePattern("h:mm a", "EEEE d MMMM", false, false));
+    }
+
+    // deve aumentar os cards maiores sem passar do espaço da coluna
+    @Test public void biggerCardsGrowButStayInsideTheCell() {
+        float density = 2f;
+        int normal = AppAdapter.tileWidthPx(1660, 4, density);
+        int bigger = HomeLook.boostedTileWidthPx(normal, 1740, 4, density, 1.1f);
+        assertTrue(bigger > normal);
+        int cell = 1740 / 4;
+        assertTrue(bigger * AppAdapter.FOCUS_SCALE <= cell - 8 * density + 1);
+        assertEquals(normal, HomeLook.boostedTileWidthPx(normal, 1740, 4, density, 1f));
+    }
+}
diff --git a/launcher/app/src/test/java/com/gathin/tvhome/IconInkTest.java b/launcher/app/src/test/java/com/gathin/tvhome/IconInkTest.java
new file mode 100644
index 0000000..bc3ec91
--- /dev/null
+++ b/launcher/app/src/test/java/com/gathin/tvhome/IconInkTest.java
@@ -0,0 +1,125 @@
+package com.gathin.tvhome;
+
+import org.junit.Test;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+
+public class IconInkTest {
+    private static final int N = 20;
+
+    /** A square icon: {@code bg} everywhere, {@code ink} in the centre block, transparent outside {@code inset}. */
+    private static int[] icon(int bg, int ink, int inset) {
+        int[] px = new int[N * N];
+        for (int y = 0; y < N; y++) {
+            for (int x = 0; x < N; x++) {
+                boolean outside = x < inset || y < inset || x >= N - inset || y >= N - inset;
+                boolean centre = x >= 7 && x < 13 && y >= 7 && y < 13;
+                px[y * N + x] = outside ? 0 : centre ? ink : bg;
+            }
+        }
+        return px;
+    }
+
+    private static int at(int[] a, int x, int y) {
+        return a[y * N + x];
+    }
+
+    // deve manter só o desenho quando o fundo do ícone já é transparente
+    @Test public void aTransparentBackgroundKeepsTheGlyphAsIs() {
+        int[] alpha = IconInk.alpha(icon(0x00000000, 0xFFE53935, 0), N, N);
+        assertEquals(255, at(alpha, 10, 10));
+        assertEquals(0, at(alpha, 3, 3));
+    }
+
+    // deve remover o quadrado branco e manter o desenho escuro
+    @Test public void removesAWhiteSquareAndKeepsADarkGlyph() {
+        int[] alpha = IconInk.alpha(icon(0xFFFFFFFF, 0xFF202020, 1), N, N);
+        assertEquals(255, at(alpha, 10, 10));
+        assertEquals(0, at(alpha, 4, 4));
+        assertEquals(0, at(alpha, 0, 0));
+    }
+
+    // deve remover o quadrado escuro e manter o desenho claro
+    @Test public void removesADarkSquareAndKeepsALightGlyph() {
+        int[] alpha = IconInk.alpha(icon(0xFF2A2A2A, 0xFFFFFFFF, 1), N, N);
+        assertEquals(255, at(alpha, 10, 10));
+        assertEquals(0, at(alpha, 4, 4));
+    }
+
+    // deve reconhecer o fundo sólido pela borda interna do ícone
+    @Test public void findsASolidBackgroundOnTheInnerRing() {
+        assertEquals(0xFFFFFFFF, IconInk.background(icon(0xFFFFFFFF, 0xFF000000, 1), N, N));
+        assertEquals(0, IconInk.background(icon(0x00000000, 0xFF000000, 0), N, N));
+    }
+
+    // deve reconhecer o fundo mesmo quando o desenho encosta em parte da borda interna
+    @Test public void findsTheBackgroundWhenTheGlyphTouchesPartOfTheRing() {
+        int[] px = icon(0xFFFFFFFF, 0xFF3050C0, 1);
+        for (int y = 2; y < 18; y++) px[y * N + 3] = 0xFFE8622C;   // a logo stroke across the left of the ring
+        assertEquals(0xFFFFFFFF, IconInk.background(px, N, N));
+        int[] alpha = IconInk.alpha(px, N, N);
+        assertEquals(0, at(alpha, 15, 15));
+        assertEquals(255, at(alpha, 3, 10));
+    }
+
+    // deve achar o fundo branco de um ícone cujo logo circular ocupa quase todo o quadrado (UniTV)
+    @Test public void findsTheBackgroundBehindALogoThatFillsMostOfTheIcon() {
+        int[] px = icon(0xFFFFFFFF, 0xFFFFFFFF, 0);
+        for (int y = 0; y < N; y++) {
+            for (int x = 0; x < N; x++) {
+                double r = Math.hypot(x - 9.5, y - 9.5);
+                if (r >= 6 && r <= 8) px[y * N + x] = 0xFFE8622C;
+            }
+        }
+        assertEquals(0xFFFFFFFF, IconInk.background(px, N, N));
+        int[] alpha = IconInk.alpha(px, N, N);
+        assertEquals(0, at(alpha, 0, 0));
+        assertEquals(0, at(alpha, 10, 10));
+        assertEquals(255, at(alpha, 17, 10));
+    }
+
+    // deve tratar fundo com várias cores como transparente e não apagar o desenho
+    @Test public void aBusyBackgroundIsNotRemoved() {
+        int[] px = icon(0xFFFFFFFF, 0xFF000000, 0);
+        int[] stripes = {0xFF0000FF, 0xFFFF0000, 0xFF00C000, 0xFFFFFF00};
+        for (int y = 0; y < N; y++) {
+            for (int x = 0; x < N; x++) if (px[y * N + x] != 0xFF000000) px[y * N + x] = stripes[x / 5];
+        }
+        assertEquals(0, IconInk.background(px, N, N));
+        int[] alpha = IconInk.alpha(px, N, N);
+        assertTrue(at(alpha, 10, 10) > 0);
+    }
+
+    // deve achar a área que o desenho ocupa, ignorando a margem transparente
+    @Test public void findsTheBoundsOfTheDrawing() {
+        int[] alpha = new int[N * N];
+        for (int y = 5; y < 12; y++) for (int x = 8; x < 11; x++) alpha[y * N + x] = 255;
+        alpha[0] = 10;   // a faint speck does not count
+        assertEquals(java.util.Arrays.toString(new int[]{8, 5, 10, 11}),
+                java.util.Arrays.toString(IconInk.bounds(alpha, N, N)));
+        assertEquals(null, IconInk.bounds(new int[N * N], N, N));
+    }
+
+    // deve encaixar desenhos de tamanhos diferentes na mesma caixa, centralizados e sem distorcer
+    @Test public void fitsEveryDrawingToTheSameBoxKeepingItsShape() {
+        float[] wide = IconInk.fit(new int[]{0, 0, 99, 49}, 144, 0.7f);
+        float[] tall = IconInk.fit(new int[]{10, 10, 29, 69}, 144, 0.7f);
+        // a maior dimensão vira 70% da caixa nos dois
+        assertEquals(144 * 0.7f, wide[2] - wide[0], 0.5f);
+        assertEquals(144 * 0.7f, tall[3] - tall[1], 0.5f);
+        // proporção mantida
+        assertEquals(2f, (wide[2] - wide[0]) / (wide[3] - wide[1]), 0.05f);
+        // centralizado
+        assertEquals(72f, (tall[0] + tall[2]) / 2, 0.5f);
+        assertEquals(72f, (wide[1] + wide[3]) / 2, 0.5f);
+    }
+
+    // deve gerar o desenho numa cor só, com a transparência da máscara
+    @Test public void paintsTheMaskInOneColour() {
+        int[] out = IconInk.paint(new int[]{255, 0, 128}, 0xFFC8C8CC);
+        assertEquals(0xFFC8C8CC, out[0]);
+        assertEquals(0x00C8C8CC, out[1]);
+        assertEquals(0x80C8C8CC, out[2]);
+    }
+}
diff --git a/launcher/app/src/test/java/com/gathin/tvhome/WeatherNowTest.java b/launcher/app/src/test/java/com/gathin/tvhome/WeatherNowTest.java
new file mode 100644
index 0000000..4fcbdb1
--- /dev/null
+++ b/launcher/app/src/test/java/com/gathin/tvhome/WeatherNowTest.java
@@ -0,0 +1,84 @@
+package com.gathin.tvhome;
+
+import org.junit.Test;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+public class WeatherNowTest {
+    private static final String RESPONSE = "{\"latitude\":-23.55,\"longitude\":-46.63,\"current_units\":{\"time\":\"iso8601\","
+            + "\"temperature_2m\":\"°C\"},\"current\":{\"time\":\"2026-10-23T05:45\",\"interval\":900,"
+            + "\"temperature_2m\":17.6,\"weather_code\":3,\"is_day\":0}}";
+
+    // deve ler temperatura, código do tempo e dia/noite da resposta da Open-Meteo
+    @Test public void readsTheCurrentBlockOfAnOpenMeteoResponse() {
+        WeatherNow w = WeatherNow.parse(RESPONSE, 1000L);
+        assertEquals(18, w.temperature);
+        assertEquals(3, w.code);
+        assertFalse(w.day);
+        assertEquals(1000L, w.fetchedAt);
+    }
+
+    // deve arredondar temperaturas negativas e decimais
+    @Test public void roundsNegativeAndDecimalTemperatures() {
+        assertEquals(-2, WeatherNow.parse(RESPONSE.replace("17.6", "-2.4"), 0).temperature);
+        assertEquals(31, WeatherNow.parse(RESPONSE.replace("17.6", "30.5"), 0).temperature);
+    }
+
+    // deve ignorar resposta vazia, de erro ou sem o bloco atual
+    @Test public void ignoresAnEmptyErrorOrIncompleteResponse() {
+        assertNull(WeatherNow.parse(null, 0));
+        assertNull(WeatherNow.parse("", 0));
+        assertNull(WeatherNow.parse("{\"error\":true,\"reason\":\"Invalid\"}", 0));
+        assertNull(WeatherNow.parse(RESPONSE.replace("\"weather_code\":3,", ""), 0));
+    }
+
+    // deve considerar o dado válido por até 2 horas
+    @Test public void aReadingStaysFreshForTwoHours() {
+        WeatherNow w = WeatherNow.parse(RESPONSE, 0);
+        assertTrue(w.fresh(2 * 60 * 60 * 1000L));
+        assertFalse(w.fresh(2 * 60 * 60 * 1000L + 1));
+        assertFalse(w.fresh(-1));
+    }
+
+    // deve escolher o ícone pela condição e pelo período do dia
+    @Test public void picksTheIconFromTheCodeAndTheTimeOfDay() {
+        assertEquals(WeatherNow.Icon.SUN, WeatherNow.icon(0, true));
+        assertEquals(WeatherNow.Icon.MOON, WeatherNow.icon(0, false));
+        assertEquals(WeatherNow.Icon.CLOUD_SUN, WeatherNow.icon(2, true));
+        assertEquals(WeatherNow.Icon.CLOUD_MOON, WeatherNow.icon(1, false));
+        assertEquals(WeatherNow.Icon.CLOUD, WeatherNow.icon(3, true));
+        assertEquals(WeatherNow.Icon.FOG, WeatherNow.icon(45, true));
+        assertEquals(WeatherNow.Icon.RAIN, WeatherNow.icon(61, false));
+        assertEquals(WeatherNow.Icon.RAIN, WeatherNow.icon(81, true));
+        assertEquals(WeatherNow.Icon.STORM, WeatherNow.icon(95, true));
+        assertEquals(WeatherNow.Icon.CLOUD, WeatherNow.icon(73, true));
+        assertEquals(WeatherNow.Icon.CLOUD, WeatherNow.icon(999, true));
+    }
+
+    // deve tratar garoa, chuva, pancadas e tempestade como chuva
+    @Test public void drizzleRainShowersAndStormsCountAsRain() {
+        for (int code : new int[]{51, 55, 61, 65, 67, 80, 82, 95, 99}) assertTrue(String.valueOf(code), WeatherNow.raining(code));
+        for (int code : new int[]{0, 1, 3, 45, 71, 86}) assertFalse(String.valueOf(code), WeatherNow.raining(code));
+    }
+
+    // deve escolher a faixa da frase pelos limites 13, 20 e 28 graus, com chuva tendo prioridade
+    @Test public void phraseBandsFollowTheSpecLimits() {
+        assertEquals(WeatherNow.Band.COLD, WeatherNow.band(12, false));
+        assertEquals(WeatherNow.Band.COOL, WeatherNow.band(13, false));
+        assertEquals(WeatherNow.Band.COOL, WeatherNow.band(19, false));
+        assertEquals(WeatherNow.Band.PLEASANT, WeatherNow.band(20, false));
+        assertEquals(WeatherNow.Band.PLEASANT, WeatherNow.band(27, false));
+        assertEquals(WeatherNow.Band.HOT, WeatherNow.band(28, false));
+        assertEquals(WeatherNow.Band.RAIN, WeatherNow.band(31, true));
+    }
+
+    // deve pedir só os três campos atuais, com a posição arredondada a ~1 km
+    @Test public void theRequestAsksOnlyForTheCurrentFieldsAtARoundedPosition() {
+        String url = WeatherNow.requestUrl(-23.550520, -46.633308);
+        assertEquals("https://api.open-meteo.com/v1/forecast?latitude=-23.55&longitude=-46.63"
+                + "&current=temperature_2m,weather_code,is_day", url);
+    }
+}
